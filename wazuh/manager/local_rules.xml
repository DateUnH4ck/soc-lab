<!--
  Reglas propias de soc-lab
  =========================
  Wazuh trae miles de reglas de serie, pero algunos ataques del curso no
  generan ninguna alerta con ellas. Aquí añadimos las que faltan para que
  todos los escenarios del replayer se vean en el dashboard desde el primer día,
  y las de los servidores del laboratorio (DNS y proxy).

  Rango de IDs reservado para el laboratorio: 100100 - 100199.
  En el curso aprenderemos a escribir reglas como estas (M7 y M14).
-->

<group name="windows,soc-lab,">

  <!--
    DCSync (T1003.006)
    Un atacante con permisos de replicación pide al controlador de dominio
    los hashes de las cuentas, haciéndose pasar por otro DC (mimikatz lsadump::dcsync).
    Se ve como un evento 4662 (operación sobre un objeto del directorio) cuyas
    propiedades incluyen los GUID de los derechos de replicación:
      1131f6aa-...  DS-Replication-Get-Changes
      1131f6ad-...  DS-Replication-Get-Changes-All
      89e95b76-...  DS-Replication-Get-Changes-In-Filtered-Set
    La replicación legítima la hacen los propios DC con cuentas de máquina
    (terminadas en $), así que las excluimos.
  -->
  <rule id="100100" level="12">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4662$</field>
    <field name="win.eventdata.properties" type="pcre2">(?i)1131f6aa-9c07-11d1-f79f-00c04fc2dcd2|1131f6ad-9c07-11d1-f79f-00c04fc2dcd2|89e95b76-444d-4c62-991a-0facbeda640c</field>
    <field name="win.eventdata.subjectUserName" type="pcre2" negate="yes">\$$</field>
    <description>Posible DCSync: $(win.eventdata.subjectUserName) ha pedido replicar el directorio (credenciales del dominio)</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1003.006</id>
    </mitre>
    <group>credential_access,dcsync,</group>
  </rule>

  <!--
    Volcado de credenciales de LSASS (T1003.001)
    Sysmon 10 = un proceso abre otro. Si el destino es lsass.exe (donde Windows
    guarda las credenciales en memoria), es lo que hace mimikatz sekurlsa::logonpasswords.
    Excluimos procesos del sistema que lo hacen de forma legítima.
  -->
  <rule id="100101" level="12">
    <if_sid>61612</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\lsass\.exe$</field>
    <field name="win.eventdata.sourceImage" type="pcre2" negate="yes">(?i)\\(svchost|wininit|csrss|services|lsm|wmiprvse|MsMpEng)\.exe$</field>
    <description>Acceso a la memoria de LSASS desde $(win.eventdata.sourceImage): posible volcado de credenciales</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access,</group>
  </rule>

  <!--
    Persistencia en las claves Run del registro (T1547.001)
    Sysmon 13 = se escribe un valor en el registro. Lo que hay en
    ...\CurrentVersion\Run(Once) se ejecuta cada vez que alguien inicia sesión.
    Wazuh ya reconoce estas claves con la regla 92300, pero con nivel 0 (no
    genera alerta salvo casos concretos). La subimos a alerta para cualquier
    escritura que no venga de un instalador de Windows.
  -->
  <rule id="100102" level="10">
    <if_sid>92300</if_sid>
    <field name="win.eventdata.image" type="pcre2" negate="yes">(?i)\\(msiexec|TrustedInstaller|setup)\.exe$</field>
    <description>Persistencia: $(win.eventdata.image) ha escrito en una clave Run del registro ($(win.eventdata.details))</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <group>persistence,</group>
  </rule>

  <!--
    Pass-the-Hash (T1550.002)
    mimikatz sekurlsa::pth abre una sesión con credenciales robadas. Se ve como
    un inicio de sesión 4624 de tipo 9 (NewCredentials) con el proceso seclogo.
  -->
  <rule id="100103" level="12">
    <if_sid>60106</if_sid>
    <field name="win.system.eventID">^4624$</field>
    <field name="win.eventdata.logonType">^9$</field>
    <field name="win.eventdata.logonProcessName" type="pcre2">(?i)^seclogo</field>
    <description>Posible Pass-the-Hash: inicio de sesión de tipo 9 (seclogo) de $(win.eventdata.targetUserName)</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1550.002</id>
    </mitre>
    <group>lateral_movement,</group>
  </rule>

  <!--
    Tarea programada creada desde la línea de comandos (T1053.005)
    Sysmon 1 = se crea un proceso. schtasks /create es la forma clásica de
    dejar persistencia que se ejecuta cada X minutos.
  -->
  <rule id="100104" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/create</field>
    <description>Tarea programada creada por línea de comandos (padre: $(win.eventdata.parentImage))</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>persistence,</group>
  </rule>

  <!--
    mshta descargando contenido de internet (T1218.005)
    mshta.exe ejecuta aplicaciones HTA; si se le pasa una URL es una técnica muy
    usada para ejecutar código remoto con un binario firmado por Microsoft (LOLBin).
  -->
  <rule id="100105" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\mshta\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)https?://</field>
    <description>LOLBin: mshta.exe ejecutando contenido remoto ($(win.eventdata.commandLine))</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1218.005</id>
    </mitre>
    <group>defense_evasion,</group>
  </rule>

  <!--
    Kerberoasting (T1558.003)
    4769 = el controlador de dominio entrega un ticket de servicio (TGS). Si se
    pide con cifrado RC4 (0x17) para una cuenta de servicio de usuario, el
    atacante puede crackear el ticket sin conexión y sacar su contraseña.
    Wazuh solo lo ve como un "inicio de sesión correcto" (60106, nivel 3) o,
    si trae IP de origen, como "inicio de sesión remoto" (92651, nivel 0: ni se
    guarda). Por eso la regla cuelga de las dos.
    Excluimos krbtgt y las cuentas de máquina (terminadas en $).
  -->
  <rule id="100106" level="12">
    <if_sid>60106, 92651</if_sid>
    <field name="win.system.eventID">^4769$</field>
    <field name="win.eventdata.ticketEncryptionType" type="pcre2">(?i)^0x0*17$</field>
    <field name="win.eventdata.serviceName" type="pcre2" negate="yes">(?i)\$$|^krbtgt$</field>
    <description>Posible Kerberoasting: ticket de servicio RC4 para $(win.eventdata.serviceName) pedido por $(win.eventdata.targetUserName)</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1558.003</id>
    </mitre>
    <group>credential_access,kerberoasting,</group>
  </rule>

  <!--
    4768 = el controlador de dominio entrega un TGT (el "carné" de Kerberos).
    Wazuh no lo guarda de serie (nivel 0). Lo subimos a nivel 3 para poder
    investigar con él: es telemetría, no algo malo.
  -->
  <rule id="100108" level="3">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4768$</field>
    <description>Kerberos: TGT entregado a $(win.eventdata.targetUserName) desde $(win.eventdata.ipAddress)</description>
    <options>no_full_log</options>
    <group>authentication_success,kerberos,</group>
  </rule>

  <!--
    AS-REP roasting (T1558.004)
    Un TGT entregado sin preautenticación (PreAuthType 0): la cuenta tiene
    desactivada la preautenticación de Kerberos y su respuesta se puede crackear.
  -->
  <rule id="100107" level="12">
    <if_sid>100108</if_sid>
    <field name="win.eventdata.preAuthType">^0$</field>
    <description>Posible AS-REP roasting: TGT sin preautenticación para $(win.eventdata.targetUserName)</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1558.004</id>
    </mitre>
    <group>credential_access,asrep_roasting,</group>
  </rule>

  <!--
    4776 = el controlador de dominio (o el equipo) valida una contraseña por NTLM.
    De serie, los correctos no se guardan; los subimos a nivel 3 (telemetría).
  -->
  <rule id="100109" level="3">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4776$</field>
    <description>NTLM: credenciales de $(win.eventdata.targetUserName) validadas en $(win.system.computer)</description>
    <options>no_full_log</options>
    <group>authentication_success,ntlm,</group>
  </rule>

</group>

<!--
  Windows (2): más detecciones para los escenarios de soc-lab 1.2 (100130-100139)
-->
<group name="windows,soc-lab,">

  <!--
    Bypass de UAC con eventvwr.exe (T1548.002)
    eventvwr.exe se ejecuta con privilegios altos sin preguntar, y antes abre lo
    que diga HKCU\Software\Classes\mscfile\shell\open\command. Quien escribe
    ahí un programa consigue que se ejecute como administrador sin el aviso de
    UAC. Wazuh vigila de serie las claves de ms-settings y Folder, no esta.
  -->
  <rule id="100130" level="12">
    <if_group>sysmon_event_13</if_group>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)mscfile\\+shell\\+open\\+command</field>
    <description>Bypass de UAC: $(win.eventdata.image) ha escrito en la clave de mscfile que abre eventvwr.exe ($(win.eventdata.details))</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1548.002</id>
    </mitre>
    <group>privilege_escalation,</group>
  </rule>

  <!--
    Cuenta local creada (T1136.001)
    Las cuentas locales viven en el registro, en HKLM\SAM\SAM\Domains\Account\Users\Names.
    Con Sysmon, crear una deja un evento 12 (CreateKey) con el nombre de la cuenta.
  -->
  <rule id="100131" level="10">
    <if_sid>61614</if_sid>
    <field name="win.eventdata.eventType">^CreateKey$</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)SAM\\+Domains\\+Account\\+Users\\+Names\\+[^\\]+$</field>
    <description>Cuenta local creada en el registro SAM: $(win.eventdata.targetObject)</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1136.001</id>
    </mitre>
    <group>persistence,account_changed,</group>
  </rule>

  <!--
    Miembros del grupo Administradores cambiados, visto en el registro (T1098)
    El grupo Administradores (alias 0x220) se guarda en ...\Builtin\Aliases\00000220.
  -->
  <rule id="100132" level="10">
    <if_group>sysmon_event_13</if_group>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)SAM\\+Domains\\+Builtin\\+Aliases\\+00000220\\+C$</field>
    <description>Cambio en los miembros del grupo Administradores (registro SAM) por $(win.eventdata.image)</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>persistence,group_changed,</group>
  </rule>

  <!--
    Enumeración por SAMR, LSARPC o SRVSVC sobre IPC$ (T1087.002)
    5145 = acceso a un recurso compartido. SharpHound (el recolector de
    BloodHound) y otras herramientas de reconocimiento abren estas "tuberías"
    de IPC$ para listar usuarios, grupos y sesiones de cada equipo.
  -->
  <rule id="100133" level="8">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^5145$</field>
    <field name="win.eventdata.shareName" type="pcre2">(?i)IPC\$$</field>
    <field name="win.eventdata.relativeTargetName" type="pcre2">(?i)^(samr|lsarpc|srvsvc)$</field>
    <description>Reconocimiento: $(win.eventdata.subjectUserName) desde $(win.eventdata.ipAddress) abre $(win.eventdata.relativeTargetName) en IPC$ (típico de BloodHound/SharpHound)</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1087.002</id>
    </mitre>
    <group>discovery,</group>
  </rule>

  <!--
    Permisos cambiados en la raíz del dominio (T1098)
    5136 con el atributo nTSecurityDescriptor sobre el objeto DC=...,DC=... (la
    raíz del dominio): alguien ha cambiado quién puede hacer qué en todo el
    dominio. Es como se concede a una cuenta normal el permiso para hacer DCSync
    (PowerView Add-DomainObjectAcl). Casi nunca pasa de forma legítima.
  -->
  <rule id="100134" level="12">
    <if_sid>60229</if_sid>
    <field name="win.eventdata.attributeLDAPDisplayName">^nTSecurityDescriptor$</field>
    <field name="win.eventdata.objectDN" type="pcre2">(?i)^DC=[^,]+(,DC=[^,]+)*$</field>
    <field name="win.eventdata.operationType" type="pcre2">14674</field>
    <description>Permisos cambiados en la raíz del dominio $(win.eventdata.objectDN) por $(win.eventdata.subjectUserName): posible concesión de DCSync</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1098</id>
      <id>T1003.006</id>
    </mitre>
    <group>persistence,dcsync,</group>
  </rule>

</group>

<!--
  DNS (srv-dns, dnsmasq)
  En Wazuh, lo que no genera alerta (nivel 3 o más) no se guarda. Para poder
  investigar con el log de DNS, cada consulta y cada respuesta generan una
  alerta de nivel 3: es telemetría, no algo malo. Encima van las detecciones.
-->
<group name="dns,soc-lab,">

  <rule id="100110" level="0">
    <decoded_as>dnsmasq</decoded_as>
    <description>dnsmasq: mensajes del servidor DNS</description>
  </rule>

  <rule id="100111" level="3">
    <if_sid>100110</if_sid>
    <field name="dns_type" type="pcre2">.</field>
    <description>DNS: $(srcip) pregunta por $(dns_query) (tipo $(dns_type))</description>
    <group>dns_query,</group>
  </rule>

  <rule id="100112" level="3">
    <if_sid>100110</if_sid>
    <field name="dns_answer" type="pcre2">.</field>
    <description>DNS: $(dns_query) es $(dns_answer) ($(dns_origin))</description>
    <group>dns_answer,</group>
  </rule>

  <!--
    Subdominio muy largo (T1071.004 / T1048)
    Los nombres normales tienen partes cortas (www, mail, srv-web). Un trozo de
    40 caracteres o más suele ser información codificada: un túnel DNS para
    sacar datos o hablar con un C2.
  -->
  <rule id="100113" level="10">
    <if_sid>100111</if_sid>
    <field name="dns_query" type="pcre2">(?:^|\.)[A-Za-z0-9_-]{40,}\.</field>
    <description>DNS: subdominio muy largo en $(dns_query) desde $(srcip) (posible túnel DNS)</description>
    <mitre>
      <id>T1071.004</id>
      <id>T1048</id>
    </mitre>
    <group>dns_tunnel,</group>
  </rule>

  <!--
    Ráfaga de consultas (T1071.004)
    Más de 30 consultas en un minuto desde el mismo equipo: un túnel DNS, un
    malware probando dominios (DGA) o un escaneo de nombres.
  -->
  <rule id="100114" level="10" frequency="30" timeframe="60">
    <if_matched_sid>100111</if_matched_sid>
    <same_srcip />
    <description>DNS: ráfaga de consultas desde $(srcip) (posible túnel DNS o DGA)</description>
    <mitre>
      <id>T1071.004</id>
    </mitre>
    <group>dns_tunnel,</group>
  </rule>

</group>

<!--
  Proxy de salida (srv-proxy, Squid)
  Cada petición que pasa por el proxy y sale bien (códigos 2xx y 3xx) genera
  una alerta de nivel 3: es el registro de navegación de la empresa. Los
  errores (4xx y 5xx) ya los cubren las reglas de serie de Wazuh (35002-35009).
-->
<group name="proxy,squid,soc-lab,">

  <rule id="100120" level="3">
    <if_sid>35000</if_sid>
    <id>^2|^3</id>
    <description>Proxy: $(srcip) ha pedido $(url) ($(action)/$(id))</description>
    <group>proxy_access,</group>
  </rule>

</group>
