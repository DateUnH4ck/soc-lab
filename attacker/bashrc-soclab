# --- soc-lab: shell del atacante -------------------------------------------
# Prompt en rojo para distinguir de un vistazo cuándo estás en la Kali (lado
# atacante) y cuándo en tu ordenador (lado defensor).
cat /etc/motd
PS1='\n\[\e[1;38;5;203m\]kali ☠ atacante\[\e[0m\] \[\e[38;5;250m\]\w\[\e[0m\]\n\[\e[1;38;5;203m\]❯\[\e[0m\] '
