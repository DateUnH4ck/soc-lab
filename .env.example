# =============================================================================
#  soc-lab · configuración (copia automática a .env en el primer setup)
# =============================================================================

# Versión de Wazuh (manager, indexer, dashboard y agentes)
WAZUH_VERSION=4.14.9

# Memoria del indexer (OpenSearch). 1g va bien con 8 GB de RAM en Docker.
# Si tienes 16 GB o más, puedes subirlo a 2g.
INDEXER_HEAP=1g

# Puertos publicados SOLO en 127.0.0.1 (tu ordenador, no tu red)
# Si el 443 está ocupado, cambia DASHBOARD_PORT (p. ej. 8443).
DASHBOARD_PORT=443
INDEXER_PORT=9200
API_PORT=55000

# Credenciales por defecto de Wazuh. NO las cambies aquí sin cambiar también
# los hashes de wazuh/indexer/internal_users.yml (ver docs/troubleshooting.md).
INDEXER_PASSWORD=SecretPassword
API_PASSWORD=MyS3cr37P450r.*-
